---
batch_connect:
  template: "basic"
  conn_params:
    - jupyter_api
script:
  job_name: "ood-jupyter"
  native:
    - "--wckey=ood_jupyter"
    - "--partition"
    - "<%= auto_queues %>"
    - "--nodes=1"
    - "--ntasks=<%= num_cores %>"
    <%- if node != '' -%>
    - "--nodelist=<%= node %>"
    <%- end -%>
    <%- if gres != 'none' -%>
    - "--gres=<%= gres %>:<%= gres_count %>"
    <%- end -%>
